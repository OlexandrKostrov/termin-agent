# Copy to .env. Never commit real values.

# LLM (Anthropic first; see docs/adr/0001-architecture.md). Used from M2.
ANTHROPIC_API_KEY=

# Outbound call allow-list (comma-separated E.164). Anything else is refused in code.
# MVP: only the simulated practice and your own numbers.
OUTBOUND_ALLOWLIST=+4930000000000

# PostgreSQL (docker-compose, arrives with the API milestone).
DATABASE_URL=postgres://termin:termin@localhost:5432/termin
